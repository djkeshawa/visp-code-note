{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "out-tests",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node",
      "vscode"
    ]
  },
  "include": [
    "src/application/**/*.ts",
    "src/domain/**/*.ts",
    "src/markdown/**/*.ts",
    "src/indexing/**/*.ts",
    "src/vscode/documentEdits.ts",
    "src/vscode/ids.ts",
    "src/vscode/providers/explorerCommands.ts",
    "src/vscode/providers/explorerModel.ts",
    "test/**/*.ts"
  ]
}
