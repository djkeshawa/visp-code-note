{
  "name": "visp-notes",
  "displayName": "Visp Notes",
  "icon": "media/icon.png",
  "description": "A Markdown-first connected notes, tasks, backlinks, and graph workspace for VS Code.",
  "version": "0.11.0",
  "publisher": "visp-code-note",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/djkeshawa/visp-code-note.git"
  },
  "homepage": "https://github.com/djkeshawa/visp-code-note#readme",
  "bugs": {
    "url": "https://github.com/djkeshawa/visp-code-note/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Notebooks",
    "Visualization",
    "Other"
  ],
  "galleryBanner": {
    "color": "#1f1d2b",
    "theme": "dark"
  },
  "qna": "https://github.com/djkeshawa/visp-code-note/issues",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "restrictedConfigurations": [
        "vispNotes.exclude",
        "vispNotes.notesFolder",
        "vispNotes.maxNoteSizeKB"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Visp Notes indexes Markdown files from the local workspace file system."
    }
  },
  "keywords": [
    "markdown",
    "notes",
    "wiki-links",
    "backlinks",
    "tasks",
    "knowledge-graph"
  ],
  "main": "./out/extension.js",
  "files": [
    "out",
    "media",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCustomEditor:vispNotes.noteEditor"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vispNotes.newNote",
        "title": "New Note",
        "category": "Visp Notes",
        "icon": "$(new-file)"
      },
      {
        "command": "vispNotes.createMissingNote",
        "title": "Create Missing Note",
        "category": "Visp Notes"
      },
      {
        "command": "vispNotes.newTask",
        "title": "New Task",
        "category": "Visp Notes",
        "icon": "$(checklist)"
      },
      {
        "command": "vispNotes.toggleTask",
        "title": "Toggle Task",
        "category": "Visp Notes",
        "icon": "$(check)"
      },
      {
        "command": "vispNotes.insertLink",
        "title": "Insert Link",
        "category": "Visp Notes"
      },
      {
        "command": "vispNotes.showBacklinks",
        "title": "Show Backlinks",
        "category": "Visp Notes"
      },
      {
        "command": "vispNotes.openLocalGraph",
        "title": "Open Local Graph",
        "category": "Visp Notes"
      },
      {
        "command": "vispNotes.openWorkspaceGraph",
        "title": "Open Workspace Graph",
        "category": "Visp Notes"
      },
      {
        "command": "vispNotes.toggleRenderedSource",
        "title": "Toggle Live / Markdown",
        "category": "Visp Notes"
      },
      {
        "command": "vispNotes.renameNote",
        "title": "Rename Note and Update Links",
        "category": "Visp Notes"
      },
      {
        "command": "vispNotes.deleteNote",
        "title": "Delete Note",
        "category": "Visp Notes",
        "icon": "$(trash)"
      },
      {
        "command": "vispNotes.findBrokenLinks",
        "title": "Find Broken Links",
        "category": "Visp Notes"
      },
      {
        "command": "vispNotes.rebuildIndex",
        "title": "Rebuild Index",
        "category": "Visp Notes",
        "icon": "$(refresh)"
      },
      {
        "command": "vispNotes.openTasks",
        "title": "Open Tasks",
        "category": "Visp Notes"
      },
      {
        "command": "vispNotes.openTodayTasks",
        "title": "Open Tasks Due Today",
        "category": "Visp Notes"
      },
      {
        "command": "vispNotes.search",
        "title": "Search Notes and Tasks",
        "category": "Visp Notes",
        "icon": "$(search)"
      },
      {
        "command": "vispNotes.openNote",
        "title": "Open Note",
        "category": "Visp Notes"
      },
      {
        "command": "vispNotes.addTag",
        "title": "Add Tag",
        "category": "Visp Notes"
      },
      {
        "command": "vispNotes.removeTag",
        "title": "Remove Tag",
        "category": "Visp Notes"
      },
      {
        "command": "vispNotes.useAsDefaultEditor",
        "title": "Use Visp Notes as the Default Markdown Editor",
        "category": "Visp Notes"
      },
      {
        "command": "vispNotes.useTextEditorByDefault",
        "title": "Restore the Built-in Markdown Text Editor",
        "category": "Visp Notes"
      }
    ],
    "customEditors": [
      {
        "viewType": "vispNotes.noteEditor",
        "displayName": "Visp Notes",
        "selector": [
          {
            "filenamePattern": "**/*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vispNotes",
          "title": "Visp Notes",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "vispNotes": [
        {
          "id": "vispNotes.workspace",
          "name": "Workspace",
          "type": "webview"
        }
      ]
    },
    "colors": [
      {
        "id": "vispNotes.hueStructure",
        "description": "Structure hue: headings, well-linked notes, and tags assigned this hue.",
        "defaults": {
          "dark": "#7fb6d8",
          "light": "#1f5f84",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "vispNotes.hueReference",
        "description": "Reference hue: links, and tags assigned this hue.",
        "defaults": {
          "dark": "#ad86dd",
          "light": "#6a3f9e",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "vispNotes.hueString",
        "description": "String hue: tag nodes in the graph, and tags assigned this hue.",
        "defaults": {
          "dark": "#6fc99a",
          "light": "#186b46",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "vispNotes.hueDeclare",
        "description": "Declaration hue: tags assigned this hue.",
        "defaults": {
          "dark": "#dcc978",
          "light": "#7a5a0d",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "vispNotes.hueLiteral",
        "description": "Literal hue: inline code, and tags assigned this hue.",
        "defaults": {
          "dark": "#f2965f",
          "light": "#a8480f",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      },
      {
        "id": "vispNotes.hueAccentuate",
        "description": "Accent hue: tags assigned this hue.",
        "defaults": {
          "dark": "#e88aa5",
          "light": "#a32d55",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vispNotes.newNote",
          "when": "view == vispNotes.workspace",
          "group": "navigation@1"
        },
        {
          "command": "vispNotes.newTask",
          "when": "view == vispNotes.workspace",
          "group": "1_create@1"
        },
        {
          "command": "vispNotes.openWorkspaceGraph",
          "when": "view == vispNotes.workspace",
          "group": "2_open@1"
        },
        {
          "command": "vispNotes.rebuildIndex",
          "when": "view == vispNotes.workspace",
          "group": "3_index@1"
        }
      ],
      "editor/context": [
        {
          "command": "vispNotes.toggleTask",
          "when": "editorLangId == markdown",
          "group": "modification@10"
        }
      ],
      "commandPalette": [
        {
          "command": "vispNotes.createMissingNote",
          "when": "false"
        },
        {
          "command": "vispNotes.openNote",
          "when": "false"
        },
        {
          "command": "vispNotes.openTodayTasks",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vispNotes.insertLink",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "vispNotes.insertLink",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "activeCustomEditorId == vispNotes.noteEditor"
      },
      {
        "command": "vispNotes.showBacklinks",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b"
      },
      {
        "command": "vispNotes.openLocalGraph",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "resourceExtname == .md"
      }
    ],
    "configuration": {
      "title": "Visp Notes",
      "properties": {
        "vispNotes.notesFolder": {
          "type": "string",
          "scope": "resource",
          "default": "notes",
          "description": "Workspace-relative folder used when creating notes. Markdown discovery still covers the entire workspace."
        },
        "vispNotes.exclude": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/out/**"
          ],
          "description": "Glob patterns excluded from the Visp Notes index."
        },
        "vispNotes.graph.defaultDepth": {
          "type": "number",
          "enum": [
            1,
            2
          ],
          "default": 1,
          "description": "Default link depth for the local knowledge graph."
        },
        "vispNotes.editor.fontFamily": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "Font family for rendered note prose. Leave empty to follow VS Code's interface font. Fenced code and inline code always follow `#editor.fontFamily#`. Only font names, quotes, commas, spaces and hyphens are accepted."
        },
        "vispNotes.editor.contentWidth": {
          "type": "string",
          "enum": [
            "readable",
            "wide",
            "full"
          ],
          "enumDescriptions": [
            "Constrain rendered notes to a comfortable reading measure.",
            "Allow rendered notes to use a wider column.",
            "Let rendered notes fill the available editor width."
          ],
          "default": "readable",
          "scope": "window",
          "description": "Measure used for note content in the Visp Notes editor."
        },
        "vispNotes.openRenderedAfterCreate": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "Open newly created notes in the Visp Notes editor."
        },
        "vispNotes.density": {
          "type": "string",
          "enum": [
            "comfortable",
            "compact"
          ],
          "default": "comfortable",
          "enumDescriptions": [
            "Rows in the workspace panel are 30 pixels tall.",
            "Rows in the workspace panel are 26 pixels tall, fitting more of the workspace on screen."
          ],
          "description": "How tall each row in the Visp Notes workspace panel is."
        },
        "vispNotes.reminders.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Show a notification when a task with a `@due(…)` date falls due. VS Code can only notify while a window is open; reminders missed while it was closed are shown once on startup."
        },
        "vispNotes.reminders.defaultTime": {
          "type": "string",
          "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$",
          "patternErrorMessage": "Use a 24-hour time such as 09:00.",
          "default": "09:00",
          "scope": "window",
          "markdownDescription": "Time of day a date-only `@due(2026-08-15)` reminder fires at. A task that names its own time — `@due(2026-08-15 14:30)` — uses that instead."
        },
        "vispNotes.reminders.leadMinutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 20160,
          "default": 0,
          "scope": "window",
          "markdownDescription": "How many minutes before it is due to remind about a task that carries no `@remind(…)` of its own."
        },
        "vispNotes.reminders.catchUpWindowHours": {
          "type": "number",
          "minimum": 0,
          "maximum": 336,
          "default": 24,
          "scope": "window",
          "description": "How far back to look for reminders that came due while VS Code was closed. Anything older is skipped silently rather than shown on startup."
        },
        "vispNotes.newNote.askFolder": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "markdownDescription": "Ask which folder a new note belongs in. When off, every note goes straight into `#vispNotes.notesFolder#`."
        },
        "vispNotes.editor.showInspector": {
          "type": "boolean",
          "default": true,
          "description": "Show the inspector beside a note — its outline, what links to it, its tasks, and what it links out to. Also toggled from the note's header."
        },
        "vispNotes.maxNoteSizeKB": {
          "type": "number",
          "minimum": 0,
          "default": 5120,
          "scope": "window",
          "markdownDescription": "Largest note, in kilobytes, that Visp Notes will index. A note above this is skipped entirely — it will not appear in the note list, the graph, search results or backlinks. The index keeps every note's full text in memory, so this bounds what a very large workspace can cost. Set to `0` for no limit."
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run compile:extension && npm run compile:webview",
    "compile:extension": "node scripts/compile-extension.mjs",
    "compile:webview": "tsc --noEmit -p tsconfig.webview.json && node scripts/build-webviews.mjs",
    "compile:test": "node scripts/compile-tests.mjs",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "lint": "eslint .",
    "test:integration": "npm run compile && npm run compile:integration && node out-integration/test/integration/runExtensionTests.js",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.integration.json",
    "test": "npm run compile:test && node --test out-tests/test/application/*.test.js out-tests/test/markdown/*.test.js out-tests/test/indexing/*.test.js",
    "vscode:prepublish": "npm run check && npm run compile"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "20.17.10",
    "@types/vscode": "1.96.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  }
}
